// NothingToWithdraw() = 0xd0d04f60
#[test(should_revert, selector = 0xd0d04f60, balance = 100_000_000_000_000_000_000)]
fn double_withdraw_reverts() uses (evm: mut Evm) {
    let auction = deploy(reserve: Wei::zero(), salt: 0)
    let a = bidder(1)
    let b = bidder(2)
    place(
        auction,
        who: a,
        amount: ether(1),
        salt: SALT_A,
        deposit: ether(1),
    )
    place(
        auction,
        who: b,
        amount: ether(2),
        salt: SALT_B,
        deposit: ether(2),
    )
    warp(auction, to: commit_end())
    open(auction, who: a, amount: ether(1), salt: SALT_A)
    open(auction, who: b, amount: ether(2), salt: SALT_B)
    warp(auction, to: reveal_end())
    settle_now(auction)
    pull(auction, who: a, to: Address::new(0xaaa1))
    pull(auction, who: a, to: Address::new(0xaaa1))
}

#[test(should_revert, selector = 0xd0d04f60, balance = 100_000_000_000_000_000_000)]
fn unrevealed_bidder_cannot_withdraw() uses (evm: mut Evm) {
    let auction = deploy(reserve: Wei::zero(), salt: 0)
    let a = bidder(1)
    place(
        auction,
        who: a,
        amount: ether(1),
        salt: SALT_A,
        deposit: ether(1),
    )
    warp(auction, to: reveal_end())
    settle_now(auction)
    pull(auction, who: a, to: Address::new(0xaaa1))
}

#[test(should_revert, selector = 0xd0d04f60)]
fn stranger_cannot_withdraw() uses (evm: mut Evm) {
    let auction = deploy(reserve: Wei::zero(), salt: 0)
    let a = bidder(1)
    warp(auction, to: reveal_end())
    settle_now(auction)
    pull(auction, who: a, to: Address::new(0xaaa1))
}
