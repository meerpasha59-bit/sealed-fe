#[test(should_revert, selector = 0x5054097b, balance = 100_000_000_000_000_000_000)]
fn copied_commitment_cannot_be_revealed_by_another_account()
uses (evm: mut Evm)
{
    // b copies a's commitment hash; it is bound to a's address, so b can't open it.
    let auction = deploy(reserve: Wei::zero(), salt: 0)
    let a = bidder(1)
    let b = bidder(2)
    let c = Commitment::of(auction, bidder: a, amount: ether(1), salt: SALT_A)
    evm.call(
        addr: a,
        gas: 500000,
        value: ether(1),
        message: BidderMsg::DoCommit { auction, commitment: c.0 },
    )
    evm.call(
        addr: b,
        gas: 500000,
        value: ether(1),
        message: BidderMsg::DoCommit { auction, commitment: c.0 },
    )
    warp(auction, to: commit_end())
    open(auction, who: b, amount: ether(1), salt: SALT_A)
}

